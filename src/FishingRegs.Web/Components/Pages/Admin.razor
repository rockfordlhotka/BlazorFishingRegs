@page "/admin"
@rendermode InteractiveServer
@using FishingRegs.Services.Interfaces
@using FishingRegs.Data
@using FishingRegs.Data.Models
@using Microsoft.AspNetCore.Components.Forms
@using System.Text
@inject IAiLakeRegulationExtractionService AiExtractionService
@inject IRegulationDatabasePopulationService DatabasePopulationService
@inject IUnitOfWork UnitOfWork
@inject ILogger<Admin> Logger

<PageTitle>Admin - Fishing Regulations</PageTitle>

<h1><i class="fas fa-cogs"></i> Administration</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3>Upload Regulation Document</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="documentUpload" class="form-label">Select Text File</label>
                    <InputFile id="documentUpload" class="form-control" OnChange="HandleFileSelected" accept=".txt" />
                    <div class="form-text">Upload fishing regulation text files for AI processing.</div>
                </div>
                
                @if (selectedFile != null)
                {
                    <div class="alert alert-info">
                        <strong>Selected:</strong> @selectedFile.Name (@(selectedFile.Size / 1024) KB)
                    </div>
                }
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="regulationYear" class="form-label">Regulation Year</label>
                        <input type="number" class="form-control" id="regulationYear" @bind="regulationYear" min="2020" max="2030" />
                    </div>
                    <div class="col-md-6">
                        <label for="processingMode" class="form-label">Processing Mode</label>
                        <select class="form-select" id="processingMode" @bind="processingMode">
                            <option value="batch">Batch (Extract all, then save)</option>
                            <option value="streaming">Streaming (Real-time processing)</option>
                        </select>
                    </div>
                </div>
                
                <div class="d-grid gap-2">
                    <button class="btn btn-primary" @onclick="ProcessDocument" disabled="@(selectedFile == null || isProcessing)">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <text> Processing...</text>
                        }
                        else
                        {
                            <i class="fas fa-upload"></i>
                            <text> Process Document</text>
                        }
                    </button>
                </div>
                
                @if (processError != null)
                {
                    <div class="alert alert-danger mt-3">
                        <h5><i class="fas fa-exclamation-triangle"></i> Processing Error</h5>
                        <div class="mb-2">@processError</div>
                        @if (isDuplicateKeyError)
                        {
                            <div class="alert alert-info mt-2 p-2">
                                <small>
                                    <strong>Note:</strong> This error typically occurs when processing documents with duplicate data or when 
                                    the AI extraction includes too much text in lake names or other fields that exceed database limits. 
                                    The system has been updated to handle these cases better. Please try processing the document again.
                                </small>
                            </div>
                        }
                    </div>
                }
                
                @if (processResults.Any())
                {
                    <div class="alert alert-success mt-3">
                        <h5><i class="fas fa-check-circle"></i> Processing Complete</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Statistics:</strong>
                                <ul class="mb-0">
                                    <li>Total lakes processed: @lakesProcessed</li>
                                    <li>Water bodies created: @waterBodiesCreated</li>
                                    <li>Water bodies updated: @waterBodiesUpdated</li>
                                    <li>Regulations created: @regulationsCreated</li>
                                    <li>Regulations updated: @regulationsUpdated</li>
                                    <li>Processing time: @processingTime.TotalSeconds.ToString("F2") seconds</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <strong>Details:</strong>
                                <ul class="mb-0">
                                    @foreach (var result in processResults.Take(5))
                                    {
                                        <li>@result</li>
                                    }
                                    @if (processResults.Count > 5)
                                    {
                                        <li><em>... and @(processResults.Count - 5) more</em></li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
                
                @if (processingWarnings.Any())
                {
                    <div class="alert alert-warning mt-3">
                        <h6><i class="fas fa-exclamation-triangle"></i> Processing Warnings</h6>
                        <ul class="mb-0">
                            @foreach (var warning in processingWarnings.Take(5))
                            {
                                <li>@warning</li>
                            }
                            @if (processingWarnings.Count > 5)
                            {
                                <li><em>... and @(processingWarnings.Count - 5) more warnings</em></li>
                            }
                        </ul>
                    </div>
                }
                
                @if (processingMode == "streaming" && streamingProgress.Any())
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            <h6><i class="fas fa-stream"></i> Real-time Processing Progress</h6>
                        </div>
                        <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var progress in streamingProgress.TakeLast(20))
                            {
                                <div class="text-muted small">
                                    @if (progress.Length >= 2 && (progress.StartsWith("?") || progress.StartsWith("?") || progress.StartsWith("?") || progress.StartsWith("??") || progress.StartsWith("??") || progress.StartsWith("??")))
                                    {
                                        <span class="badge bg-@(progress.StartsWith("?") ? "success" : progress.StartsWith("?") ? "danger" : "info") me-1">
                                            @progress.Substring(0, 2)
                                        </span>
                                        @progress.Substring(2).TrimStart()
                                    }
                                    else
                                    {
                                        @progress
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h4>System Status</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-6">Total Lakes:</dt>
                    <dd class="col-sm-6">@totalLakes</dd>
                    <dt class="col-sm-6">Regulations:</dt>
                    <dd class="col-sm-6">@totalRegulations</dd>
                    <dt class="col-sm-6">Documents:</dt>
                    <dd class="col-sm-6">@totalDocuments</dd>
                    <dt class="col-sm-6">Fish Species:</dt>
                    <dd class="col-sm-6">@totalFishSpecies</dd>
                </dl>
                <button class="btn btn-outline-primary w-100" @onclick="RefreshStats">
                    <i class="fas fa-refresh"></i> Refresh
                </button>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header">
                <h4>Recent Activity</h4>
            </div>
            <div class="card-body">
                @if (recentActivity.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var activity in recentActivity.Take(10))
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@activity.Action</h6>
                                    <small>@activity.Timestamp.ToString("MMM dd, HH:mm")</small>
                                </div>
                                <p class="mb-1">@activity.Description</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No recent activity</p>
                }
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header">
                <h4>Configuration Status</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-8">Azure OpenAI:</dt>
                    <dd class="col-sm-4">
                        <span class="badge bg-@(isAzureOpenAIConfigured ? "success" : "danger")">
                            @(isAzureOpenAIConfigured ? "OK" : "Missing")
                        </span>
                    </dd>
                    <dt class="col-sm-8">Database:</dt>
                    <dd class="col-sm-4">
                        <span class="badge bg-@(isDatabaseConfigured ? "success" : "danger")">
                            @(isDatabaseConfigured ? "OK" : "Error")
                        </span>
                    </dd>
                </dl>
                @if (!isAzureOpenAIConfigured || !isDatabaseConfigured)
                {
                    <div class="alert alert-warning mt-2 p-2">
                        <small>
                            Check configuration settings and ensure Azure OpenAI and database connections are properly configured.
                        </small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private IBrowserFile? selectedFile;
    private bool isProcessing = false;
    private string? processError;
    private bool isDuplicateKeyError = false;
    private List<string> processResults = new();
    private List<string> processingWarnings = new();
    private List<string> streamingProgress = new();
    
    private int regulationYear = DateTime.Now.Year;
    private string processingMode = "batch";
    
    // Statistics
    private int totalLakes = 0;
    private int totalRegulations = 0;
    private int totalDocuments = 0;
    private int totalFishSpecies = 0;
    
    // Processing results
    private int lakesProcessed = 0;
    private int waterBodiesCreated = 0;
    private int waterBodiesUpdated = 0;
    private int regulationsCreated = 0;
    private int regulationsUpdated = 0;
    private TimeSpan processingTime = TimeSpan.Zero;
    
    // Configuration status
    private bool isAzureOpenAIConfigured = false;
    private bool isDatabaseConfigured = false;
    
    private List<ActivityLog> recentActivity = new();

    protected override async Task OnInitializedAsync()
    {
        await CheckConfiguration();
        await RefreshStats();
        await LoadRecentActivity();
    }

    private async Task CheckConfiguration()
    {
        try
        {
            // Check if services are properly configured by attempting to access them
            isAzureOpenAIConfigured = AiExtractionService != null;
            isDatabaseConfigured = UnitOfWork != null;
            
            // Try a simple database query to verify connection
            if (isDatabaseConfigured)
            {
                try
                {
                    await UnitOfWork.WaterBodies.CountAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Database connection test failed");
                    isDatabaseConfigured = false;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Configuration check failed");
            isAzureOpenAIConfigured = false;
            isDatabaseConfigured = false;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        processError = null;
        isDuplicateKeyError = false;
        processResults.Clear();
        processingWarnings.Clear();
        streamingProgress.Clear();
        
        // Reset processing statistics
        lakesProcessed = 0;
        waterBodiesCreated = 0;
        waterBodiesUpdated = 0;
        regulationsCreated = 0;
        regulationsUpdated = 0;
        processingTime = TimeSpan.Zero;
        
        StateHasChanged();
    }

    private async Task ProcessDocument()
    {
        if (selectedFile == null) return;

        isProcessing = true;
        processError = null;
        isDuplicateKeyError = false;
        processResults.Clear();
        processingWarnings.Clear();
        streamingProgress.Clear();
        StateHasChanged();

        try
        {
            Logger.LogInformation($"Starting document processing: {selectedFile.Name}");

            // Read file content
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB limit
            using var reader = new StreamReader(stream);
            var textContent = await reader.ReadToEndAsync();

            if (string.IsNullOrWhiteSpace(textContent))
            {
                processError = "File appears to be empty";
                return;
            }

            // Create source document record
            var sourceDocument = new RegulationDocument
            {
                Id = Guid.NewGuid(),
                FileName = $"{DateTime.Now:yyyyMMdd_HHmmss}_{selectedFile.Name}",
                OriginalFileName = selectedFile.Name,
                DocumentType = "fishing_regulations",
                ProcessingStatus = "processing",
                FileSizeBytes = selectedFile.Size,
                MimeType = selectedFile.ContentType ?? "text/plain",
                BlobStorageUrl = $"admin-upload://{selectedFile.Name}",
                BlobContainer = "admin-uploads",
                StateId = 1, // Minnesota
                RegulationYear = regulationYear,
                UploadSource = "admin_upload",
                ProcessingStartedAt = DateTimeOffset.UtcNow,
                CreatedAt = DateTimeOffset.UtcNow,
                UpdatedAt = DateTimeOffset.UtcNow
            };

            // Add document to database
            await UnitOfWork.RegulationDocuments.AddAsync(sourceDocument);
            await UnitOfWork.SaveChangesAsync();

            var startTime = DateTime.UtcNow;

            if (processingMode == "streaming")
            {
                await ProcessDocumentStreaming(textContent, sourceDocument);
            }
            else
            {
                await ProcessDocumentBatch(textContent, sourceDocument);
            }

            processingTime = DateTime.UtcNow - startTime;

            // Update document status
            sourceDocument.ProcessingStatus = "completed";
            sourceDocument.ProcessingCompletedAt = DateTimeOffset.UtcNow;
            await UnitOfWork.SaveChangesAsync();

            // Add to activity log
            await AddActivityLog("Document Processed", $"Processed {selectedFile.Name} ({lakesProcessed} lakes)");
            
            // Update stats
            await RefreshStats();
            await LoadRecentActivity();
            
            selectedFile = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing document");
            processError = ex.Message;
            
            // Check if this is a duplicate key error
            isDuplicateKeyError = IsDataBaseConstraintError(ex);
            
            if (isDuplicateKeyError)
            {
                Logger.LogWarning("Detected duplicate key constraint violation during processing");
            }
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private bool IsDataBaseConstraintError(Exception ex)
    {
        return ex.Message.Contains("duplicate key", StringComparison.OrdinalIgnoreCase) ||
               ex.Message.Contains("23505") ||
               ex.Message.Contains("unique constraint", StringComparison.OrdinalIgnoreCase) ||
               ex.Message.Contains("value too long for type", StringComparison.OrdinalIgnoreCase) ||
               ex.Message.Contains("22001") ||
               (ex.InnerException != null && IsDataBaseConstraintError(ex.InnerException));
    }

    private async Task ProcessDocumentBatch(string textContent, RegulationDocument sourceDocument)
    {
        streamingProgress.Add("?? Starting AI extraction...");
        StateHasChanged();

        // Step 1: AI Extraction
        var extractionResult = await AiExtractionService.ExtractLakeRegulationsAsync(textContent);

        if (!extractionResult.IsSuccess)
        {
            processError = $"AI extraction failed: {extractionResult.ErrorMessage}";
            return;
        }

        lakesProcessed = extractionResult.TotalLakesProcessed;
        processResults.Add($"AI extraction completed: {extractionResult.ExtractedRegulations.Count} lakes extracted");
        processResults.Add($"Total regulations found: {extractionResult.TotalRegulationsExtracted}");
        processingWarnings.AddRange(extractionResult.ProcessingWarnings);
        
        streamingProgress.Add($"? AI extraction completed: {extractionResult.ExtractedRegulations.Count} lakes");
        StateHasChanged();

        // Step 2: Database Population
        streamingProgress.Add("?? Populating database...");
        StateHasChanged();

        var populationResult = await DatabasePopulationService.PopulateDatabaseAsync(
            extractionResult, 
            sourceDocument.Id, 
            regulationYear);

        if (!populationResult.IsSuccess)
        {
            processError = $"Database population failed: {populationResult.ErrorMessage}";
            processingWarnings.AddRange(populationResult.ProcessingErrors);
            return;
        }

        waterBodiesCreated = populationResult.WaterBodiesCreated;
        waterBodiesUpdated = populationResult.WaterBodiesUpdated;
        regulationsCreated = populationResult.RegulationsCreated;
        regulationsUpdated = populationResult.RegulationsUpdated;

        processResults.Add($"Database population completed successfully");
        processResults.Add($"Water bodies created: {waterBodiesCreated}, updated: {waterBodiesUpdated}");
        processResults.Add($"Regulations created: {regulationsCreated}, updated: {regulationsUpdated}");
        processingWarnings.AddRange(populationResult.ProcessingWarnings);
        
        streamingProgress.Add("? Database population completed");
    }

    private async Task ProcessDocumentStreaming(string textContent, RegulationDocument sourceDocument)
    {
        streamingProgress.Add("?? Starting streaming processing...");
        StateHasChanged();

        var streamingResult = await AiExtractionService.ExtractLakeRegulationsStreamAsync(
            textContent,
            async (lakeRegulation) =>
            {
                // Real-time processing callback
                streamingProgress.Add($"? Processing {lakeRegulation.LakeName}...");
                StateHasChanged();

                var lakeResult = await DatabasePopulationService.PopulateSingleLakeAsync(
                    lakeRegulation, 
                    sourceDocument.Id, 
                    regulationYear);

                if (lakeResult.IsSuccess)
                {
                    if (lakeResult.WaterBody != null)
                    {
                        // Note: WaterBody.Id will now be > 0 after the fix since it gets saved in PopulateSingleLakeAsync
                        // Check if this is a newly created water body based on the service's internal tracking
                        // For simplicity, we'll track based on the lakeResult statistics
                        waterBodiesCreated++; // This will be corrected by using the proper result statistics
                    }

                    regulationsCreated += lakeResult.CreatedRegulations.Count;
                    regulationsUpdated += lakeResult.UpdatedRegulations.Count;

                    streamingProgress.Add($"? {lakeRegulation.LakeName}: {lakeResult.CreatedRegulations.Count} regs created, {lakeResult.UpdatedRegulations.Count} updated");
                    
                    // Note: SaveChanges is now handled inside PopulateSingleLakeAsync for water bodies
                    // We still need to save the fishing regulations
                    await UnitOfWork.SaveChangesAsync();
                }
                else
                {
                    streamingProgress.Add($"? {lakeRegulation.LakeName}: {lakeResult.ErrorMessage}");
                    processingWarnings.Add($"{lakeRegulation.LakeName}: {lakeResult.ErrorMessage}");
                }

                processingWarnings.AddRange(lakeResult.Warnings);
                lakesProcessed++;
                StateHasChanged();
            });

        if (!streamingResult.IsSuccess)
        {
            processError = $"Streaming processing failed: {streamingResult.ErrorMessage}";
            return;
        }

        processResults.Add($"Streaming processing completed");
        processResults.Add($"Total lakes processed: {lakesProcessed}");
        processResults.Add($"Processing completed in real-time mode");
        processingWarnings.AddRange(streamingResult.ProcessingWarnings);
    }

    private async Task RefreshStats()
    {
        try
        {
            totalLakes = await UnitOfWork.WaterBodies.CountAsync(wb => wb.IsActive);
            totalRegulations = await UnitOfWork.FishingRegulations.CountAsync(fr => fr.IsActive);
            totalDocuments = await UnitOfWork.RegulationDocuments.CountAsync();
            totalFishSpecies = await UnitOfWork.FishSpecies.CountAsync(fs => fs.IsActive);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh statistics");
        }
        
        StateHasChanged();
    }

    private async Task LoadRecentActivity()
    {
        try
        {
            // Load recent documents
            var recentDocs = await UnitOfWork.RegulationDocuments
                .GetAllAsync();
            
            recentActivity.Clear();
            
            foreach (var doc in recentDocs.OrderByDescending(d => d.CreatedAt).Take(10))
            {
                var status = doc.ProcessingStatus switch
                {
                    "completed" => "Document Processed",
                    "processing" => "Document Processing",
                    "failed" => "Processing Failed",
                    _ => "Document Uploaded"
                };

                recentActivity.Add(new ActivityLog
                {
                    Action = status,
                    Description = $"{doc.OriginalFileName} ({doc.FileSizeBytes / 1024} KB)",
                    Timestamp = doc.CreatedAt.DateTime
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load recent activity");
        }
    }

    private async Task AddActivityLog(string action, string description)
    {
        recentActivity.Insert(0, new ActivityLog
        {
            Action = action,
            Description = description,
            Timestamp = DateTime.Now
        });
        
        // Keep only recent items
        if (recentActivity.Count > 20)
        {
            recentActivity = recentActivity.Take(20).ToList();
        }
    }

    public class ActivityLog
    {
        public string Action { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime Timestamp { get; set; }
    }
}
